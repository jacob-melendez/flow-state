# Copy this file to .env.local and fill in your Supabase project's values:
#   cp .env.example .env.local
# Find them in the Supabase dashboard → Project Settings → API (or the "Connect" button).
# .env.local is ignored by git. Restart `npx expo start` after changing it.
#
# Leave these empty to run the app fully offline (no accounts), like v1.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The "publishable" key (sb_publishable_...), or the legacy "anon public" key.
# This key is meant to be public: the database's row-level security protects the data.
# Never put the "secret" / "service_role" key here.
EXPO_PUBLIC_SUPABASE_KEY=
